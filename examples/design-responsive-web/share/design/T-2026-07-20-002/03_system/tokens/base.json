{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "primary":      { "$type": "color", "$value": "#5B4B8A", "$description": "Brand purple — primary CTAs" },
    "primary-deep": { "$type": "color", "$value": "#3D2F66", "$description": "Hover, footer" },
    "primary-tint": { "$type": "color", "$value": "#EDE9F5", "$description": "Subtle purple backgrounds" },
    "warm":         { "$type": "color", "$value": "#F4ECDF", "$description": "Warm beige page background" },
    "ink":          { "$type": "color", "$value": "#1A1814", "$description": "Primary text" },
    "ink-2":        { "$type": "color", "$value": "#4A453D", "$description": "Secondary text" },
    "ink-3":        { "$type": "color", "$value": "#8A8278", "$description": "Tertiary text" },
    "line":         { "$type": "color", "$value": "#E2DCCF", "$description": "Borders, dividers" },
