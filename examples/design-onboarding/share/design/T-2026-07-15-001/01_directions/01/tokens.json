{
  "theme": "ios-hig",
  "extends": "tokens/base.json (NOT shipped in this scope=small example — see 02_system/tokens/base.json schema)",
  "color": {
    "bg":       { "$type": "color", "$value": "#F2F2F7" },
    "surface":  { "$type": "color", "$value": "#FFFFFF" },
    "ink":      { "$type": "color", "$value": "#000000" },
    "ink-2":    { "$type": "color", "$value": "#3C3C43" },
    "ink-3":    { "$type": "color", "$value": "#8E8E93" },
    "line":     { "$type": "color", "$value": "rgba(60,60,67,0.12)" },
    "accent":   { "$type": "color", "$value": "#007AFF" },
    "green":    { "$type": "color", "$value": "#34C759" }
  },
  "typography": {
    "family-ui":   { "$type": "fontFamily", "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif" },
    "fs-display":  { "$type": "dimension", "$value": "32px" },
    "fs-body":     { "$type": "dimension", "$value": "17px" },
    "fs-caption":  { "$type": "dimension", "$value": "13px" },
    "lh-body":     { "$type": "number", "$value": 1.4 }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "18px" }
  }
}